{
  "name": "figma2code",
  "version": "1.0.0",
  "description": "Autonomous AI agent for converting Figma designs to React + TypeScript + TailwindCSS code",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "agent": "tsx src/cli.ts",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "figma",
    "react",
    "typescript",
    "tailwindcss",
    "code-generation",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.68.0",
    "axios": "^1.7.7",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^23.6.0",
    "zod": "^3.23.8",
    "ora": "^8.1.0",
    "archiver": "^7.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^22.8.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
